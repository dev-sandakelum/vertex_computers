# ──────────────────────────────────────────────────────────────────────────────
# Stage 1 – deps
#   Install only production node_modules so the final image stays small.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

# Copy package manifests and install prod deps only
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2 – builder
#   Install ALL deps (including devDeps), then build the app.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

# Copy source
COPY . .

# next.config.ts must have output: "standalone" for this to work
RUN npm run build

# ──────────────────────────────────────────────────────────────────────────────
# Stage 3 – runner
#   Minimal production image – only the standalone bundle + static assets.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
# Disable Next.js telemetry inside the container
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user for security
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Copy the standalone server and its bundled dependencies
COPY --from=builder /app/.next/standalone ./
# Copy static assets (served by the Next.js server)
COPY --from=builder /app/.next/static  ./.next/static
# Copy the public folder (favicon, images, etc.)
COPY --from=builder /app/public        ./public

# The standalone server runs as this user
USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]
